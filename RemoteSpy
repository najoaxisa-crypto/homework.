-- VARIABLES
local selectedRemote = nil
local remoteButtons = {}
local looping = false
local loopThread = nil

local function isSuspicious(remote)
    local n = remote.Name:lower()
    return n:find("kick") or n:find("ban") or n:find("punish") or n:find("mod") or n:find("admin") or n:find("report") or n:find("blacklist")
end

-- SCAN FUNCTION (fixed closure + suspicious colors)
local function refreshRemotes()
    for _, btn in ipairs(remoteButtons) do btn:Destroy() end
    remoteButtons = {}
    SelectedLabel.Text = "Selected: None"
    SelectedLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
    selectedRemote = nil
    looping = false
    if loopThread then task.cancel(loopThread) loopThread = nil end

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local fullName = obj:GetFullName()
            if fullName:match("^RobloxReplicatedStorage") or fullName:match("^CorePackages") or fullName:match("^CoreGui") or fullName:match("^StarterPlayer") or fullName:match("^ReplicatedFirst") then continue end

            local thisRemote = obj  -- FIX: capture for closure

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -8, 0, 26)
            btn.TextColor3 = Color3.fromRGB(205, 205, 225)
            btn.TextSize = 12
            btn.Font = Enum.Font.Code
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.TextTruncate = Enum.TextTruncate.AtEnd
            btn.Parent = Scroll
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

            if isSuspicious(thisRemote) then
                btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                btn.Text = "[Suspicious] " .. thisRemote.Name .. "  (" .. (thisRemote:IsA("RemoteEvent") and "Event" or "Function") .. ")  -  " .. fullName
            else
                btn.BackgroundColor3 = COL_BTN
                btn.Text = thisRemote.Name .. "  (" .. (thisRemote:IsA("RemoteEvent") and "Event" or "Function") .. ")  -  " .. fullName
            end

            btn.MouseButton1Click:Connect(function()
                selectedRemote = thisRemote
                local isSusp = isSuspicious(thisRemote)
                SelectedLabel.Text = "Selected: " .. thisRemote.Name .. (isSusp and " [SUSPICIOUS - may kick/ban!]" or "")
                SelectedLabel.TextColor3 = isSusp and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(150, 150, 170)

                for _, b in ipairs(remoteButtons) do
                    local susp = isSuspicious(thisRemote)
                    b.BackgroundColor3 = (b == btn) and Color3.fromRGB(70, 130, 180) or (susp and Color3.fromRGB(200, 50, 50) or COL_BTN)
                end
            end)

            table.insert(remoteButtons, btn)
        end
    end
end

RefreshBtn.MouseButton1Click:Connect(refreshRemotes)

-- FIRE LOGIC
FireBtn.MouseButton1Click:Connect(function()
    if not selectedRemote then
        SelectedLabel.Text = "Selected: NONE - click a remote first!"
        return
    end

    local argsText = ArgsBox.Text
    if argsText == "" then argsText = "{}" end

    local success, args = pcall(function() return loadstring("return " .. argsText)() end)
    local argTable = success and (type(args) == "table" and args or {args}) or {}

    if selectedRemote:IsA("RemoteEvent") then
        pcall(selectedRemote.FireServer, selectedRemote, unpack(argTable))
    else
        pcall(selectedRemote.InvokeServer, selectedRemote, unpack(argTable))
    end

    SelectedLabel.Text = "FIRED! " .. selectedRemote.Name
    task.delay(1.2, function()
        if selectedRemote then
            local isSusp = isSuspicious(selectedRemote)
            SelectedLabel.Text = "Selected: " .. selectedRemote.Name .. (isSusp and " [SUSPICIOUS - may kick/ban!]" or "")
            SelectedLabel.TextColor3 = isSusp and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(150, 150, 170)
        end
    end)
end)

-- AUTO LOOP LOGIC
local function startAutoLoop()
    if not selectedRemote or looping then return end
    looping = true
    StartLoopBtn.Text = "LOOPING..."
    StopLoopBtn.Text = "STOP"

    loopThread = task.spawn(function()
        while looping and selectedRemote do
            local argsText = ArgsBox.Text
            if argsText == "" then argsText = "{}" end
            local success, args = pcall(function() return loadstring("return " .. argsText)() end)
            local argTable = success and (type(args) == "table" and args or {args}) or {}

            if selectedRemote:IsA("RemoteEvent") then
                pcall(selectedRemote.FireServer, selectedRemote, unpack(argTable))
            else
                pcall(selectedRemote.InvokeServer, selectedRemote, unpack(argTable))
            end

            task.wait(tonumber(DelayBox.Text) or 0.1)
        end
    end)
end

local function stopAutoLoop()
    looping = false
    if loopThread then
        task.cancel(loopThread)
        loopThread = nil
    end
    StartLoopBtn.Text = "Start Auto Loop"
    StopLoopBtn.Text = "STOP"
end

StartLoopBtn.MouseButton1Click:Connect(startAutoLoop)
StopLoopBtn.MouseButton1Click:Connect(stopAutoLoop)

-- SCRATCH CODE GENERATOR (fixed - no backticks)
GenCodeBtn.MouseButton1Click:Connect(function()
    if not selectedRemote then
        SelectedLabel.Text = "Select a remote first!"
        return
    end

    local delay = tonumber(DelayBox.Text) or 0.1
    local fullName = selectedRemote:GetFullName():gsub('"', '\\"')
    local argsStr = ArgsBox.Text ~= "" and ArgsBox.Text or "{}"

    local scratchCode = "-- Spunchbub RemoveEvent Code for: " .. selectedRemote.Name .. "\n\n"
    scratchCode = scratchCode .. "local remote\nfor _, r in ipairs(game:GetDescendants()) do\n    if r:GetFullName() == \"" .. fullName .. "\" then\n        remote = r\n        break\n    end\nend\n\n"
    scratchCode = scratchCode .. "if not remote then warn(\"[Scratch] Remote not found!\") return end\n\n"
    scratchCode = scratchCode .. "print(\"Auto-farm started for " .. selectedRemote.Name .. " (delay " .. delay .. ")\")\nwhile true do\n"
    scratchCode = scratchCode .. "    local args = " .. argsStr .. "\n    if typeof(args) ~= \"table\" then args = {args} end\n    \n"
    scratchCode = scratchCode .. "    if remote:IsA(\"RemoteEvent\") then\n        pcall(function() remote:FireServer(unpack(args)) end)\n    else\n        pcall(function() remote:InvokeServer(unpack(args)) end)\n    end\n"
    scratchCode = scratchCode .. "    task.wait(" .. delay .. ")\nend"

    CodeOutput.Text = scratchCode
    CodeOutput:CaptureFocus()
    CodeOutput.SelectionStart = 1
    CodeOutput.CursorPosition = #CodeOutput.Text + 1
    SelectedLabel.Text = "autoloop code generated"
end)

