	frame.Position = UDim2.new(0.5, 0, 0.5, 0)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -30, 0, 45)
	title.Position = UDim2.new(0, 15, 0, 15)
	title.BackgroundTransparency = 1
	title.Text = "Select a Player"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextScaled = true
	title.Font = Enum.Font.GothamBold
	title.Parent = frame

	local info = Instance.new("TextLabel")
	info.Size = UDim2.new(1, -30, 0, 35)
	info.Position = UDim2.new(0, 15, 0, 60)
	info.BackgroundTransparency = 1
	info.Text = "Click a player to print lots of info, then choose recording mode."
	info.TextColor3 = Color3.fromRGB(220, 220, 220)
	info.TextScaled = true
	info.TextWrapped = true
	info.Font = Enum.Font.Gotham
	info.Parent = frame

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -40, 1, -150)
	scroll.Position = UDim2.new(0, 20, 0, 105)
	scroll.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	scroll.BorderSizePixel = 0
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.ScrollBarThickness = 8
	scroll.Parent = frame

	local scrollCorner = Instance.new("UICorner")
	scrollCorner.CornerRadius = UDim.new(0, 8)
	scrollCorner.Parent = scroll

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = scroll

	local function refreshList()
		for _, child in ipairs(scroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local text = player.Name .. " | " .. player.DisplayName .. " | " .. player.UserId
			local button = makeButton(scroll, text, UDim2.new(0, 0, 0, 0), UDim2.new(1, -5, 0, 45), Color3.fromRGB(45, 45, 45))

			button.MouseButton1Click:Connect(function()
				selectedPlayer = player
				recordMode = false
				recordLog = {}
				disconnectRecording()
				printPlayerInformation(player)
				showRecordPrompt(player)
			end)
		end

		task.wait()
		scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 25)
	end

	local refresh = makeButton(frame, "REFRESH", UDim2.new(0, 20, 1, -55), UDim2.new(0, 150, 0, 40), Color3.fromRGB(50, 100, 180))
	local close = makeButton(frame, "CLOSE", UDim2.new(1, -170, 1, -55), UDim2.new(0, 150, 0, 40), Color3.fromRGB(120, 40, 40))

	refresh.MouseButton1Click:Connect(refreshList)
	close.MouseButton1Click:Connect(destroyGui)

	refreshList()
end

Players.PlayerRemoving:Connect(function(player)
	if selectedPlayer == player then
		addRecord("PLAYER LEFT GAME", player.Name .. " [" .. player.UserId .. "] left the server")
		safeCall(function()
			StarterGui:SetCore("SendNotification", {
				Title = "Selected Player Left",
				Text = player.Name .. " left the server.",
				Duration = 5
			})
		end)
	end
end)

Players.PlayerAdded:Connect(function(player)
	if recordMode and selectedPlayer then
		addRecord("OTHER PLAYER JOINED", player.Name .. " joined while recording " .. selectedPlayer.Name)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightShift then
		printRecordLog()
	elseif input.KeyCode == Enum.KeyCode.R then
		if selectedPlayer and selectedPlayer.Parent == Players then
			printPlayerInformation(selectedPlayer)
		else
			print("No selected player to refresh.")
		end
	elseif input.KeyCode == Enum.KeyCode.P then
		createPlayerSelector()
	end
end)

task.wait(1)

safeCall(function()
	StarterGui:SetCore("SendNotification", {
		Title = "Player Info Script Loaded",
		Text = "Pick a player. Press P to open selector again.",
		Duration = 6
	})
end)

createPlayerSelector()
