local Players = game:GetService("Players")
local UserService = game:GetService("UserService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local selectedPlayer = nil
local recordMode = false
local recordLog = {}
local recordingConnections = {}
local uiGui = nil
local recordingSession = 0

local function safeCall(func)
	local success, result = pcall(func)
	if success then
		return result
	end
	return "Unavailable"
end

local function divider(text)
	print("")
	print("============================================================")
	print(text)
	print("============================================================")
end

local function printLine(name, value)
	print(name .. ": " .. tostring(value))
end

local function boolText(value)
	if value == true then
		return "Yes"
	elseif value == false then
		return "No"
	end
	return tostring(value)
end

local function getTime()
	return os.date("%Y-%m-%d %H:%M:%S")
end

local function addRecord(eventName, information)
	if not recordMode then
		return
	end

	local entry = "[" .. getTime() .. "] " .. eventName .. " | " .. information
	table.insert(recordLog, entry)
	print("[RECORD MODE] " .. entry)
end

local function disconnectRecording()
	for _, connection in ipairs(recordingConnections) do
		if connection and connection.Disconnect then
			connection:Disconnect()
		end
	end

	recordingConnections = {}
	recordingSession += 1
end

local function countClass(container, className)
	if not container then
		return 0
	end

	local amount = 0

	for _, item in ipairs(container:GetDescendants()) do
		if item:IsA(className) then
			amount += 1
		end
	end

	return amount
end

local function getAccessories(character)
	if not character then
		return "None"
	end

	local list = {}

	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Accessory") then
			table.insert(list, item.Name)
		end
	end

	if #list == 0 then
		return "None"
	end

	return table.concat(list, ", ")
end

local function getTools(character)
	if not character then
		return "None"
	end

	local list = {}

	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			table.insert(list, item.Name)
		end
	end

	if #list == 0 then
		return "None"
	end

	return table.concat(list, ", ")
end

local function printAttributes(instance)
	local attributes = instance:GetAttributes()
	local found = false

	for name, value in pairs(attributes) do
		found = true
		printLine("Attribute - " .. name, value)
	end

	if not found then
		printLine("Attributes", "None")
	end
end

local function printLeaderstats(player)
	local leaderstats = player:FindFirstChild("leaderstats")

	if not leaderstats then
		printLine("Leaderstats", "None")
		return
	end

	for _, stat in ipairs(leaderstats:GetChildren()) do
		if stat:IsA("ValueBase") then
			printLine("Leaderstat - " .. stat.Name, stat.Value)
		else
			printLine("Leaderstat - " .. stat.Name, stat.ClassName)
		end
	end
end

local function getVerifiedInfo(userId)
	local result = safeCall(function()
		local infos = UserService:GetUserInfosByUserIdsAsync({userId})
		if infos and infos[1] then
			return infos[1]
		end
		return nil
	end)

	if typeof(result) == "table" then
		return result
	end

	return nil
end

local function getLocalPing()
	return safeCall(function()
		return math.floor(localPlayer:GetNetworkPing() * 1000) .. " ms"
	end)
end

local function getMemory()
	return safeCall(function()
		return math.floor(Stats:GetTotalMemoryUsageMb()) .. " MB"
	end)
end

