local function printCharacterInformation(player)
	divider("CHARACTER INFORMATION")

	local character = player.Character

	if not character then
		printLine("Character", "Not loaded")
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	printLine("Character Name", character.Name)
	printLine("Character Parent", character.Parent and character.Parent.Name or "None")
	printLine("Total Descendants", #character:GetDescendants())
	printLine("BaseParts", countClass(character, "BasePart"))
	printLine("MeshParts", countClass(character, "MeshPart"))
	printLine("Accessories", getAccessories(character))
	printLine("Equipped Tools", getTools(character))

	if humanoid then
		printLine("Humanoid Found", "Yes")
		printLine("Health", math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth))
		printLine("WalkSpeed", humanoid.WalkSpeed)
		printLine("JumpPower", humanoid.JumpPower)
		printLine("JumpHeight", humanoid.JumpHeight)
		printLine("UseJumpPower", boolText(humanoid.UseJumpPower))
		printLine("Rig Type", humanoid.RigType.Name)
		printLine("Current State", humanoid:GetState().Name)
		printLine("Sit", boolText(humanoid.Sit))
		printLine("PlatformStand", boolText(humanoid.PlatformStand))
		printLine("AutoRotate", boolText(humanoid.AutoRotate))
		printLine("Requires Neck", boolText(humanoid.RequiresNeck))
		printLine("BreakJointsOnDeath", boolText(humanoid.BreakJointsOnDeath))
		printLine("Display Distance Type", humanoid.DisplayDistanceType.Name)
		printLine("Health Display Type", humanoid.HealthDisplayType.Name)
		printLine("Name Display Distance", humanoid.NameDisplayDistance)
		printLine("Health Display Distance", humanoid.HealthDisplayDistance)
	else
		printLine("Humanoid", "Not found")
	end

	if root then
		printLine("Root Position", tostring(root.Position))
		printLine("Root Velocity", tostring(root.AssemblyLinearVelocity))
		printLine("Root Anchored", boolText(root.Anchored))
	else
		printLine("HumanoidRootPart", "Not found")
	end

	printAttributes(character)
end

local function printPlayerInformation(player)
	selectedPlayer = player

	divider("SELECTED PLAYER INFORMATION")

	printLine("Printed At", getTime())
	printLine("Username", player.Name)
	printLine("Display Name", player.DisplayName)
	printLine("User ID", player.UserId)
	printLine("Account Age", player.AccountAge .. " days")
	printLine("Membership Type", player.MembershipType.Name)
	printLine("Is Local Player", boolText(player == localPlayer))
	printLine("Is Friend With You", safeCall(function()
		return boolText(localPlayer:IsFriendsWith(player.UserId))
	end))
	printLine("Team", player.Team and player.Team.Name or "None")
	printLine("Team Color", player.TeamColor.Name)
	printLine("Neutral", boolText(player.Neutral))
	printLine("Parent", player.Parent and player.Parent.Name or "None")
	printLine("Player Child Count", #player:GetChildren())
	printLine("Record Mode Currently", boolText(recordMode))
	printLine("Your Ping", getLocalPing())
	printLine("Client Memory", getMemory())
	printLine("Server Job ID", game.JobId)
	printLine("Place ID", game.PlaceId)
	printLine("Game ID / Universe ID", game.GameId)
	printLine("Place Version", game.PlaceVersion)
	printLine("Current Player Count", #Players:GetPlayers())
	printLine("Max Players", Players.MaxPlayers)

	local userInfo = getVerifiedInfo(player.UserId)

	if userInfo then
		printLine("Verified Badge", boolText(userInfo.HasVerifiedBadge))
		printLine("UserService Username", userInfo.Username)
		printLine("UserService Display Name", userInfo.DisplayName)
	else
		printLine("Verified Badge", "Unavailable")
	end

	divider("PLAYER ATTRIBUTES")
	printAttributes(player)

	divider("LEADERSTATS")
	printLeaderstats(player)

	printCharacterInformation(player)
	printHumanoidDescription(player)

	divider("END OF PLAYER INFORMATION")
	print("Press RightShift to print the record log.")
	print("Press R to print this selected player's information again.")
	print("")
end

local function printRecordLog()
	divider("RECORDED LOG FOR SELECTED PLAYER")

	if not selectedPlayer then
		print("No selected player.")
		return
	end

	printLine("Selected Player", selectedPlayer.Name .. " [" .. selectedPlayer.UserId .. "]")
	printLine("Record Mode", boolText(recordMode))
	printLine("Entries", #recordLog)

	if #recordLog == 0 then
		print("No events recorded yet.")
		return
	end

	for number, entry in ipairs(recordLog) do
		print(number .. ". " .. entry)
	end
end

local function setupCharacterRecording(player, character, session)
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		humanoid = safeCall(function()
			return character:WaitForChild("Humanoid", 10)
		end)
	end

	if typeof(humanoid) == "Instance" and humanoid:IsA("Humanoid") then
		local lastHealth = humanoid.Health

		table.insert(recordingConnections, humanoid.Died:Connect(function()
			addRecord("DIED", player.Name .. " died")
		end))

		table.insert(recordingConnections, humanoid.HealthChanged:Connect(function(newHealth)
			if math.abs(newHealth - lastHealth) >= 5 or newHealth <= 0 then
				addRecord("HEALTH CHANGE", player.Name .. " health changed from " .. math.floor(lastHealth) .. " to " .. math.floor(newHealth))
				lastHealth = newHealth
			end
		end))

		table.insert(recordingConnections, humanoid.StateChanged:Connect(function(oldState, newState)
			addRecord("STATE CHANGE", player.Name .. " changed from " .. oldState.Name .. " to " .. newState.Name)
		end))

		table.insert(recordingConnections, humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
			addRecord("SIT CHANGE", player.Name .. " Sit = " .. boolText(humanoid.Sit))
		end))

		table.insert(recordingConnections, humanoid:GetPropertyChangedSignal("PlatformStand"):Connect(function()
			addRecord("PLATFORM STAND CHANGE", player.Name .. " PlatformStand = " .. boolText(humanoid.PlatformStand))
		end))
	end

	table.insert(recordingConnections, character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			addRecord("TOOL EQUIPPED", player.Name .. " equipped " .. child.Name)
		elseif child:IsA("Accessory") then
			addRecord("ACCESSORY ADDED", player.Name .. " accessory appeared: " .. child.Name)
		end
	end))

	table.insert(recordingConnections, character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			addRecord("TOOL UNEQUIPPED", player.Name .. " unequipped " .. child.Name)
		elseif child:IsA("Accessory") then
			addRecord("ACCESSORY REMOVED", player.Name .. " accessory removed: " .. child.Name)
		end
	end))

	task.spawn(function()
		while recordMode and selectedPlayer == player and recordingSession == session do
			task.wait(15)

			if not recordMode or selectedPlayer ~= player or recordingSession ~= session then
				break
			end

			local currentCharacter = player.Character
			local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
			local root = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")

			if currentHumanoid and root then
				addRecord("STATUS CHECK", "Health " .. math.floor(currentHumanoid.Health) .. "/" .. math.floor(currentHumanoid.MaxHealth) .. " | Position " .. tostring(root.Position))
			elseif currentCharacter then
				addRecord("STATUS CHECK", "Character exists but humanoid or root part is missing")
			else
				addRecord("STATUS CHECK", "Character is not loaded")
			end
		end
	end)
end

local function startRecordingPlayer(player)
	disconnectRecording()

	recordMode = true
	recordLog = {}
	recordingSession += 1

	local session = recordingSession

	addRecord("RECORDING STARTED", "Recording " .. player.Name .. " [" .. player.UserId .. "]")

	table.insert(recordingConnections, player:GetPropertyChangedSignal("Team"):Connect(function()
		addRecord("TEAM CHANGE", player.Name .. " team changed to " .. (player.Team and player.Team.Name or "None"))
	end))

	table.insert(recordingConnections, player:GetPropertyChangedSignal("TeamColor"):Connect(function()
		addRecord("TEAM COLOR CHANGE", player.Name .. " team color changed to " .. player.TeamColor.Name)
	end))

	table.insert(recordingConnections, player:GetPropertyChangedSignal("Neutral"):Connect(function()
		addRecord("NEUTRAL CHANGE", player.Name .. " Neutral = " .. boolText(player.Neutral))
	end))

	table.insert(recordingConnections, player.CharacterAdded:Connect(function(character)
		addRecord("CHARACTER ADDED", player.Name .. " spawned a new character")
		setupCharacterRecording(player, character, session)
	end))

	table.insert(recordingConnections, player.CharacterRemoving:Connect(function(character)
		addRecord("CHARACTER REMOVING", player.Name .. " character is being removed")
	end))

	if player.Character then
		setupCharacterRecording(player, player.Character, session)
	end
end

local function stopRecording()
	disconnectRecording()
	recordMode = false
	addRecord("RECORDING STOPPED", "Recording was stopped")
end

local function destroyGui()
	if uiGui then
		uiGui:Destroy()
		uiGui = nil
	end
end

local function makeButton(parent, text, position, size, color)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextScaled = true
	button.TextWrapped = true
	button.Font = Enum.Font.GothamBold
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	return button
end

